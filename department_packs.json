      {"name": "availability", "formula": "safe_div(operating_minutes, planned_minutes) * 100", "round": 2}
    ],
    "filters": [{"field": "date", "label": "Date", "type": "date_range"}, {"field": "line", "label": "Line", "type": "select"}, {"field": "shift", "label": "Shift", "type": "select"}, {"field": "model", "label": "Model", "type": "select"}, {"field": "_search", "label": "Search", "type": "search"}],
    "kpis": [
      {"id": "plan", "label": "Plan", "type": "sum", "field": "plan_qty", "format": "number"},
      {"id": "actual", "label": "Actual", "type": "sum", "field": "actual_qty", "format": "number"},
      {"id": "achievement", "label": "Achievement", "type": "ratio", "numerator": "actual_qty", "denominator": "plan_qty", "multiply": 100, "format": "percent"},
      {"id": "yield", "label": "Yield", "type": "ratio", "numerator": "good_qty", "denominator": "actual_qty", "multiply": 100, "format": "percent"},
      {"id": "downtime", "label": "Downtime Minutes", "type": "sum", "field": "downtime_minutes", "format": "number"}
    ],
    "charts": [
      {"id": "plan_actual", "title": "Plan vs Actual by Line", "type": "stacked", "group_by": "line", "series_by": "_measure", "measures": [{"name": "Plan", "field": "plan_qty"}, {"name": "Actual", "field": "actual_qty"}], "aggregation": "sum", "limit": 12},
      {"id": "output_trend", "title": "Production Trend", "type": "line", "group_by": "date", "value": "actual_qty", "aggregation": "sum", "limit": 31},
      {"id": "downtime_line", "title": "Downtime by Line", "type": "pareto", "group_by": "line", "value": "downtime_minutes", "aggregation": "sum", "limit": 12},
      {"id": "model_mix", "title": "Model Mix", "type": "donut", "group_by": "model", "value": "actual_qty", "aggregation": "sum", "limit": 10}
    ],
    "table": {"columns": ["record_id", "date", "line", "shift", "model", "plan_qty", "actual_qty", "achievement", "good_qty", "yield_rate", "downtime_minutes"], "max_rows": 200}
  },
