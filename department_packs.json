      "critical_fields": ["record_id", "date"],
      "field_types": {"record_id": "text", "date": "date", "line": "text", "shift": "text", "model": "text", "plan_qty": "number", "actual_qty": "number", "good_qty": "number", "planned_minutes": "number", "operating_minutes": "number", "downtime_minutes": "number"},
