  "generic": {
    "source_defaults": {
      "required_fields": ["record_id", "department", "category", "amount", "status", "date"],
      "critical_fields": ["record_id"],
      "field_types": {"record_id": "text", "department": "text", "category": "text", "amount": "number", "target": "number", "status": "text", "date": "date"},
      "column_aliases": {
        "record_id": ["record id", "id", "reference", "transaction id"],
        "department": ["department", "dept", "team", "function"],
        "category": ["category", "type", "group"],
        "amount": ["amount", "value", "cost", "sales"],
        "target": ["target", "plan", "budget"],
        "status": ["status", "state"],
        "date": ["date", "day", "created date", "report date"]
      }
    },
    "derived_fields": [{"name": "variance", "formula": "amount - target", "round": 2}],
    "filters": [
      {"field": "date", "label": "Date", "type": "date_range"},
      {"field": "department", "label": "Department", "type": "select"},
      {"field": "category", "label": "Category", "type": "select"},
      {"field": "status", "label": "Status", "type": "select"},
      {"field": "_search", "label": "Search", "type": "search"}
    ],
    "kpis": [
      {"id": "records", "label": "Records", "type": "count", "format": "number"},
      {"id": "total_amount", "label": "Total Amount", "type": "sum", "field": "amount", "format": "currency"},
      {"id": "total_target", "label": "Total Target", "type": "sum", "field": "target", "format": "currency"},
      {"id": "achievement", "label": "Achievement", "type": "ratio", "numerator": "amount", "denominator": "target", "multiply": 100, "format": "percent"}
    ],
    "charts": [
      {"id": "amount_by_category", "title": "Amount by Category", "type": "bar", "group_by": "category", "value": "amount", "aggregation": "sum", "limit": 10},
      {"id": "trend", "title": "Daily Trend", "type": "line", "group_by": "date", "value": "amount", "aggregation": "sum", "limit": 24},
      {"id": "status_mix", "title": "Status Mix", "type": "donut", "group_by": "status", "aggregation": "count", "limit": 8},
      {"id": "department_performance", "title": "Department Performance", "type": "pareto", "group_by": "department", "value": "amount", "aggregation": "sum", "limit": 10}
    ],
    "table": {"columns": ["record_id", "date", "department", "category", "amount", "target", "variance", "status"], "max_rows": 200}
  },
