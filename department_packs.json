  "quality": {
    "source_defaults": {
      "required_fields": ["record_id", "date", "line", "model", "inspected_qty", "defect_qty"],
      "critical_fields": ["record_id", "date"],
      "field_types": {"record_id": "text", "date": "date", "line": "text", "model": "text", "inspected_qty": "number", "defect_qty": "number", "rework_qty": "number", "defect_type": "text"},
      "column_aliases": {
        "record_id": ["record id", "inspection id", "lot id", "id"],
        "date": ["date", "inspection date", "day"],
        "line": ["line", "production line"],
        "model": ["model", "model code", "product"],
        "inspected_qty": ["inspected qty", "inspection quantity", "checked qty", "total inspected"],
        "defect_qty": ["defect qty", "defects", "ng qty", "failed qty"],
        "rework_qty": ["rework qty", "repair qty", "reworked"],
        "defect_type": ["defect type", "failure mode", "defect"]
      }
    },
    "derived_fields": [
      {"name": "defect_rate", "formula": "safe_div(defect_qty, inspected_qty) * 100", "round": 3},
      {"name": "yield_rate", "formula": "safe_div(inspected_qty - defect_qty, inspected_qty) * 100", "round": 3},
      {"name": "ppm", "formula": "safe_div(defect_qty, inspected_qty) * 1000000", "round": 0}
    ],
    "filters": [{"field": "date", "label": "Date", "type": "date_range"}, {"field": "line", "label": "Line", "type": "select"}, {"field": "model", "label": "Model", "type": "select"}, {"field": "defect_type", "label": "Defect", "type": "select"}, {"field": "_search", "label": "Search", "type": "search"}],
    "kpis": [
      {"id": "inspected", "label": "Inspected", "type": "sum", "field": "inspected_qty", "format": "number"},
      {"id": "defects", "label": "Defects", "type": "sum", "field": "defect_qty", "format": "number"},
      {"id": "defect_rate", "label": "Defect Rate", "type": "ratio", "numerator": "defect_qty", "denominator": "inspected_qty", "multiply": 100, "format": "percent"},
      {"id": "yield", "label": "Yield", "type": "formula", "formula": "100 - defect_rate", "format": "percent"}
    ],
    "charts": [
      {"id": "defect_pareto", "title": "Defect Pareto", "type": "pareto", "group_by": "defect_type", "value": "defect_qty", "aggregation": "sum", "limit": 12},
      {"id": "quality_trend", "title": "Defect Trend", "type": "line", "group_by": "date", "value": "defect_qty", "aggregation": "sum", "limit": 31},
      {"id": "model_quality", "title": "Defects by Model", "type": "bar", "group_by": "model", "value": "defect_qty", "aggregation": "sum", "limit": 12},
      {"id": "line_model_heat", "title": "Line × Model Heatmap", "type": "heatmap", "group_by": "line", "series_by": "model", "value": "defect_qty", "aggregation": "sum", "limit": 10}
    ],
    "table": {"columns": ["record_id", "date", "line", "model", "inspected_qty", "defect_qty", "defect_rate", "yield_rate", "ppm", "defect_type"], "max_rows": 200}
  },
  "production": {
    "source_defaults": {
